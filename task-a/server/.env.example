# =============================================================================
# Page Pulse — Server environment variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# =============================================================================

# HTTP port the server listens on.
# Default: 3001
# PORT=3001

# Node environment.
# Set to "development" to expose error details on 5xx responses.
# Default: (undefined → production behaviour)
# NODE_ENV=development

# Allowed origin for CORS (the frontend's URL).
# Default: http://localhost:5173
# CORS_ORIGIN=http://localhost:5173

# Rate-limit window in milliseconds.
# Default: 60000 (1 minute)
# RATE_LIMIT_WIN=60000

# Maximum requests per rate-limit window.
# Default: 60
# RATE_LIMIT_MAX=60
