# =============================================================================
# Page Pulse — Client environment variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Vite exposes variables prefixed with VITE_ to the client bundle.
# =============================================================================

# URL of the /api/analyze endpoint in production.
# In development the Vite proxy handles this — no need to set it.
# Default: /api/analyze (proxy in dev; override for production)
# VITE_API_URL=https://page-pulse-api.onrender.com/api/analyze

# Backend port used by the Vite dev proxy.
# Only needed when the backend falls back to a non-default port.
# Default: 3001
# VITE_API_PORT=3001
